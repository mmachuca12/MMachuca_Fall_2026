total = 0.0
while signal == "Yes":
    print("Please enter a quantity: ")
    qty = int(input())
    print("Please enter a unit price: $")
    price = float(input())
    ep = compute(qty, price)
    total = total + ep
    print("Quantity: " + str(qty))
    print("Unit price: $" + str(price))
    print("Extended price: $" + str(ep))
