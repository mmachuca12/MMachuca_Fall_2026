def computePrice(model, msrp, make, response):
    if model == "Honda Accord":
        pctMSRP = 0.1
    if model == "Toyota Rav4":
        pctMSRP = 0.15
    if response == "Y":
        pctMSRP = 0.3
    else:
        pctMSRP = 0.05
    discountedPrice = msrp - msrp * pctMSRP
    newTotal = discountedPrice + 0.07
    
    return newTotal

# Main
