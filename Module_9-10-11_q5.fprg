<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="q5"/>
        <attribute name="authors" value="maria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-02 04:12:30 PM"/>
        <attribute name="created" value="bWFyaWE7TUFSSUE7MjAyNi0xMC0wMTswNjo1Mzo1NiBQTTsyMTY1"/>
        <attribute name="edited" value="bWFyaWE7TUFSSUE7MjAyNi0xMC0wMjswNDoxMjozMCBQTTsxOzIyNTk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="discRate" type="Real" array="False" size=""/>
            <declare name="byRefdiscAmt" type="Real" array="True" size="1"/>
            <declare name="byRefdiscPrice" type="Real" array="True" size="1"/>
            <declare name="signal" type="String" array="False" size=""/>
            <assign variable="signal" expression="&quot;Yes&quot;"/>
            <output expression="&quot;Do you want to start this program? (Yes/No)&quot;" newline="True"/>
            <input variable="signal"/>
            <while expression="signal==&quot;Yes&quot;">
                <output expression="&quot;Please input a quantity: &quot;" newline="True"/>
                <input variable="qty"/>
                <output expression="&quot;Please input a price: $&quot;" newline="True"/>
                <input variable="price"/>
                <output expression="&quot;Please input a discount rate: &quot;" newline="True"/>
                <input variable="discRate"/>
                <call expression="compute(qty, discRate, price, byRefdiscAmt, byRefdiscPrice)"/>
                <output expression="&quot;Do you want to enter more data? (Yes/No)&quot;" newline="True"/>
                <input variable="signal"/>
                <output expression="&quot;The quantity you entered is: &quot;&amp;qty" newline="True"/>
                <output expression="&quot;The price you entered is: $&quot;&amp;price" newline="True"/>
                <output expression="&quot;The discount amount is $&quot;&amp;byRefdiscAmt[0]" newline="True"/>
                <output expression="&quot;The discounted price is $&quot;&amp;byRefdiscPrice[0]" newline="True"/>
            </while>
        </body>
    </function>
    <function name="compute" type="None" variable="">
        <parameters>
            <parameter name="qty" type="Integer" array="False"/>
            <parameter name="discRate" type="Real" array="False"/>
            <parameter name="price" type="Real" array="False"/>
            <parameter name="byRefdiscAmt" type="Real" array="True"/>
            <parameter name="byRefdiscPrice" type="Real" array="True"/>
        </parameters>
        <body>
            <declare name="discPrice" type="Real" array="False" size=""/>
            <declare name="discAmt" type="Real" array="False" size=""/>
            <assign variable="discPrice" expression="0"/>
            <assign variable="discAmt" expression="0"/>
            <assign variable="byRefDiscAmt[0]" expression="qty*price*discRate"/>
            <assign variable="byRefdiscPrice[0]" expression="(qty*price)-byRefdiscAmt[0]"/>
            <assign variable="discPrice" expression="(qty*price)-discAmt"/>
        </body>
    </function>
    <function name="compute1" type="None" variable="discPrice">
        <parameters/>
        <body/>
    </function>
</flowgorithm>
