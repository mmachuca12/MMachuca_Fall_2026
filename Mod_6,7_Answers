#Answer to Question 4

count_ordered = 0
unique_items = 0
total_sum = 0

with open('Question_4.txt', "r") as file:
    for line in file:
        item = line.strip()
        
        qty_row = file.readline()
        if not qty_row:
            break
        qty = int(float(qty_row.strip()))
        
        price_row = file.readline()
        if not price_row:
            break
        price = float(price_row.strip())
        
#calculations

        ep = qty * price

        
        print(f"Item: {item}")
        print(f"Quantity ordered: {qty}")
        print(f"Price of item: $ {price}")
        print(f"Extended price: $ {ep}")
        
        total_sum += ep
        count_ordered += qty
        unique_items += 1

if unique_items > 0:
    average = total_sum / unique_items
else:
    average = 0
    
print(f"Sum of extended prices: $ {total_sum}")
print(f"Total quantity of products ordered: {count_ordered}")
print(f"Average order price: $ {average}")

#Answer to Question 5

credits_taken = 0
tuition_owed = 0
total_owed = 0
sum_students = 0

with open('Question_5.txt', "r") as file:
    for line in file:
        surname = line.strip()
        
        district_row = file.readline()
        if not district_row:
            break
        district_code = str(district_row.strip())
        
        credit_row = file.readline()
        if not credit_row:
            break
        credits_taken = int(float(credit_row.strip()))

#calculations
#charge = cost per credits

        if district_code == "I":
            charge = 250.00
        else:
            charge = 500.00
        tuition_owed = credits_taken * charge
        total_owed += tuition_owed
        sum_students += 1
        
        print(f"Student Last Name: {surname}")
        print(f"Credits Taken: {credits_taken}")
        print(f"Tuition Owed: $ {tuition_owed}")

print(f"Sum of all tuition owed: $ {total_owed}")
print(f"Number of students: {sum_students}")

