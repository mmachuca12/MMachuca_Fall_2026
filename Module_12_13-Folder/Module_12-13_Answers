student_dictionary = {"Machuca": [89, 92, 87], "Jones": [91, 86, 89], "Harvey": [82, 85, 89], "Johnson": [77, 78, 86]}

def student_avg(student_dictionary):
    avg_list = []
    
    for name, grades in student_dictionary.items():
        total = 0
        count = 0
        for grade in grades:
            total += grade
            count += 1
        student_avg = total / count
        avg_list.append([name, student_avg])
    
    return avg_list

def class_avg(student_dictionary):
    exam_totals = [0, 0, 0]
    student_count = 0
    
    for grades in student_dictionary.values():
        exam_totals[0] += grades[0]
        exam_totals[1] += grades[1]
        exam_totals[2] += grades[2]
        student_count += 1
    
    class_avg = [exam_totals[0]/student_count, exam_totals[1]/student_count, exam_totals[2]/student_count]
    
    return class_avg

student_average = student_avg(student_dictionary)

print(f"{'Student Name':<15} | {'Overall Average Grade': <20}")
print("-" * 30)

for row in student_average:
    name = row[0]
    avg = row[1]
    print(f"{name:<15} | {avg:<20.2f}")
print("-" * 30)

class_exams = class_avg(student_dictionary)
print("-Class Average Per Exam-")
print(f"Exam 1 Average: {class_exams[0]:.2f}")
print(f"Exam 2 Average: {class_exams[1]:.2f}")
print(f"Exam 3 Average: {class_exams[2]:.2f}")

