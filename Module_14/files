class Employee:
    
    def __init__(self, first, last, pay):
        self.first = first
        self.last = last
        self.pay = pay
        self.email = first + "." + last + "@company.com"

    def fullname(self):
        return '{} {}'.format(self.first, self.last)
    
    def calculate_bonus(self, bonus):
        return self.pay * bonus
        
emp_1 = Employee('Corey', 'Schafer', 50000)
emp_2 = Employee('Test', 'User', 60000)

br_1 = 0.15
br_2 = 0.10

bonus_1 = emp_1.calculate_bonus(br_1)
bonus_2 = emp_2.calculate_bonus(br_2)

print(f"Employee: {emp_1.fullname()} | Bonus: {bonus_1}")
print(f"Employee: {emp_2.fullname()} | Bonus: {bonus_2}")

