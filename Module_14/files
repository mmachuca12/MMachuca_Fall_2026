class Students:
   
    def __init__(self, first, last, district, credits):
        self.first = first
        self.last = last
        self.district = district
        self.credits = credits

    def fullname(self):
      
        return '{} {}'.format(self.first, self.last)
    
    def tuition(self):
        if self.district=='I':
            return self.credits * 250.00
        else:
            return self.credits * 500.00

student_1 = Students('Maria', 'Machuca', 'I', 10)
student_2 = Students('Corey', 'Jones', 'O', 15)
student_3 = Students('Alyssa', 'Adams', 'O', 12)
student_4 = Students('Jim', 'Hess', 'I', 16)

rate_1 = student_1.tuition()
rate_2 = student_2.tuition()
rate_3 = student_3.tuition()
rate_4 = student_4.tuition()

print(f"Student: {student_1.fullname()} | Tuition Owed: {rate_1:.2f}")
print(f"Student: {student_2.fullname()} | Tuition Owed: {rate_2:.2f}")
print(f"Student: {student_3.fullname()} | Tuition Owed: {rate_3:.2f}")
