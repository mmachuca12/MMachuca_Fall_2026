<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="q1"/>
        <attribute name="authors" value="maria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 07:28:02 AM"/>
        <attribute name="created" value="bWFyaWE7TUFSSUE7MjAyNi0wOS0yOTswNDo0NjoyMSBQTTsyMTc1"/>
        <attribute name="edited" value="bWFyaWE7TUFSSUE7MjAyNi0wOS0zMDswNzoyODowMiBBTTsxOzIyNjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="qty" type="Integer" array="False" size=""/>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="ep" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="Yes" type="String" array="False" size=""/>
            <declare name="signal" type="String" array="False" size=""/>
            <assign variable="signal" expression="&quot;Yes&quot;"/>
            <assign variable="total" expression="0.0"/>
            <while expression="signal == &quot;Yes&quot;">
                <output expression="&quot;Please enter a quantity: &quot;" newline="True"/>
                <input variable="qty"/>
                <output expression="&quot;Please enter a unit price: $&quot;" newline="True"/>
                <input variable="price"/>
                <assign variable="ep" expression="compute(qty, price)"/>
                <assign variable="total" expression="total + ep"/>
                <output expression="&quot;Quantity: &quot;&amp;qty" newline="True"/>
                <output expression="&quot;Unit price: $&quot; &amp;price" newline="True"/>
                <output expression="&quot;Extended price: $&quot;&amp;ep" newline="True"/>
                <output expression="&quot;Do you want to add another item? (Yes/No)&quot;" newline="True"/>
                <input variable="signal"/>
            </while>
            <output expression="&quot;Total price for all items: $&quot;&amp;total" newline="True"/>
        </body>
    </function>
    <function name="compute" type="Real" variable="ep">
        <parameters>
            <parameter name="qty" type="Integer" array="False"/>
            <parameter name="price" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="ep" type="Real" array="False" size=""/>
            <assign variable="ep" expression="qty * price"/>
            <if expression="ep &gt; 10000">
                <then>
                    <assign variable="ep" expression="ep * 0.90"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
