surname = ["Machuca", "Jones", "Harvey", "Johnson", "Myers", "Peters", "Bryant", "Ochoa", "Cruz", "Adams"]

def displaynames(surname):
    print("-Names in Order-")
    for name in surname:
        print(name)

def displaynames_reverse(surname):
    print("Names in Reverse-")
    
    index = len(surname) - 1
    
    for i in range(index, -1, -1):
        print(surname[i])

displaynames(surname)
displaynames_reverse(surname)

