<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="q3"/>
        <attribute name="authors" value="maria"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 07:27:46 AM"/>
        <attribute name="created" value="bWFyaWE7TUFSSUE7MjAyNi0wOS0zMDswNDo0ODozNyBQTTsyMTc2"/>
        <attribute name="edited" value="bWFyaWE7TUFSSUE7MjAyNi0xMC0wMTswNzoyNzo0NiBBTTsxOzIyNTk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="surname" type="String" array="False" size=""/>
            <declare name="sales" type="Real" array="False" size=""/>
            <declare name="month" type="String" array="False" size=""/>
            <declare name="nextMonthFcast" type="Real" array="False" size=""/>
            <declare name="nextMonthSale" type="Real" array="False" size=""/>
            <declare name="forecastpct" type="Real" array="False" size=""/>
            <assign variable="nextMonthFcast" expression="0"/>
            <declare name="signal" type="String" array="False" size=""/>
            <assign variable="signal" expression="&quot;Yes&quot;"/>
            <declare name="Yes" type="String" array="False" size=""/>
            <output expression="&quot;Do you want to input data into the program? (Yes/No)&quot;" newline="True"/>
            <input variable="Yes"/>
            <while expression="signal==&quot;Yes&quot;">
                <output expression="&quot;Please input your last name: &quot;" newline="True"/>
                <input variable="surname"/>
                <output expression="&quot;Please enter a month: &quot;" newline="True"/>
                <input variable="month"/>
                <output expression="&quot;Please enter a sales amount: $&quot;" newline="True"/>
                <input variable="sales"/>
                <assign variable="nextMonthSale" expression="computeForecast(sales, month)"/>
                <output expression="&quot;Next month's forecasted sales amount is $&quot; &amp;nextMonthSale" newline="True"/>
                <output expression="&quot;Do you want to input more data into the program? (Yes/No)&quot;" newline="True"/>
                <input variable="signal"/>
            </while>
            <output expression="&quot;Thank you for using this program.&quot;" newline="True"/>
        </body>
    </function>
    <function name="computeForecast" type="Real" variable="nextMonthSale">
        <parameters>
            <parameter name="sales" type="Real" array="False"/>
            <parameter name="month" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="forecastpct" type="Real" array="False" size=""/>
            <declare name="nextMonthSale" type="Real" array="False" size=""/>
            <if expression="month==&quot;Jan&quot; or month==&quot;Feb&quot; or month==&quot;Mar&quot;">
                <then>
                    <assign variable="forecastpct" expression="0.10"/>
                </then>
                <else/>
            </if>
            <if expression="month==&quot;Apr&quot; or month==&quot;May&quot; or month==&quot;Jun&quot;">
                <then>
                    <assign variable="forecastpct" expression="0.15"/>
                </then>
                <else/>
            </if>
            <if expression="month==&quot;Jul&quot; or month==&quot;Aug&quot; or month==&quot;Sep&quot;">
                <then>
                    <assign variable="forecastpct" expression="0.20"/>
                </then>
                <else/>
            </if>
            <if expression="month==&quot;Oct&quot; or month==&quot;Nov&quot; or month==&quot;Dec&quot;">
                <then>
                    <assign variable="forecastpct" expression="0.25"/>
                </then>
                <else/>
            </if>
            <assign variable="nextMonthSale" expression="sales * (1+forecastpct)"/>
        </body>
    </function>
</flowgorithm>
